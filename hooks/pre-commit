#!/bin/sh
# Advisory AI code review of staged changes.
# NEVER blocks the commit — it only prints findings, then exits 0.
# Disable:  git config --unset core.hooksPath   (or delete this file)
#
# Review logic lives in scripts/ai-review.mjs (shared with `npm run review`).

command -v node >/dev/null 2>&1 || exit 0

echo "🔍 Advisory AI code review (commit will proceed regardless)..."
node scripts/ai-review.mjs --staged || true

exit 0
